PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/gig_matrix
JWT_SECRET=replace-this-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173

# Configure all SMTP values to enable password reset email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=GiG Matrix <no-reply@example.com>

# Used only by npm run migrate:mysql.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=my_database
